# =========================================================================
# AOMaster — variables d'environnement
# Copier ce fichier en `.env` et renseigner les valeurs pour votre Supabase.
# Toute variable préfixée `VITE_` est exposée au bundle client (jamais y mettre
# de secret côté serveur).
# =========================================================================

# --- Supabase (obligatoire) ---
# URL de votre projet Supabase, format https://xxxxx.supabase.co
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Clé publique anon de votre projet Supabase (Settings → API → anon public)
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# =========================================================================
# Variables côté Edge Functions (Supabase) — à définir avec
# `supabase secrets set NAME=value` ou dans le dashboard.
# Elles ne sont PAS lues par le bundle Vite, donc pas de préfixe VITE_.
# =========================================================================

# Clé service Supabase (admin) — requise par les fonctions create-admin,
# create-users, invite-user, force-password-change, process-alerts, etc.
# SUPABASE_SERVICE_ROLE_KEY="..."

# URL du site frontend (sert au CORS et aux liens d'invitation).
# Ex: http://localhost:5173 en dev, https://votre-domaine.tld en prod.
# SITE_URL="http://localhost:5173"

# Compte administrateur initial à créer via la fonction `create-admin`.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="ChangezMoi!2026"
